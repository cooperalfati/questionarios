rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      // Google: e-mail verificado. Microsoft (Firebase não marca como verificado):
      // só contas do Microsoft 365 da Cooperalfa
      return request.auth != null && (
        request.auth.token.email_verified == true
        || (request.auth.token.firebase.sign_in_provider == 'microsoft.com'
            && request.auth.token.email.lower().matches('.*@cooperalfa[.]coop[.]br'))
      );
    }
    // Administradores: documento config/admins com o campo emails (lista, em minúsculas)
    function isAdmin() {
      return logado()
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    match /config/admins {
      allow read: if logado();
      allow write: if isAdmin();
    }

    // Questionários: o convidado (sem login) lê só o documento do seu questionário
    match /questionarios/{qid} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Lista de convidados e texto do convite: só administradores
    match /convites/{qid} {
      allow read, write: if isAdmin();
    }

    // Link pessoal: tokens/{token} = {qid, email}. O token (128 bits aleatórios) é o segredo do link.
    match /tokens/{token} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Resposta do convidado: id = <qid>_<token>. Quem tem o link lê e altera a própria resposta.
    match /respostas/{rid} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['qid', 'token', 'email', 'respostas', 'enviadoEm'])
        && request.resource.data.token is string
        && rid == request.resource.data.qid + '_' + request.resource.data.token
        && exists(/databases/$(database)/documents/tokens/$(request.resource.data.token))
        && get(/databases/$(database)/documents/tokens/$(request.resource.data.token)).data.qid == request.resource.data.qid
        && get(/databases/$(database)/documents/tokens/$(request.resource.data.token)).data.email == request.resource.data.email
        && get(/databases/$(database)/documents/questionarios/$(request.resource.data.qid)).data.ativo == true;
    }
  }
}

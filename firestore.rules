rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() {
      return request.auth.token.email.lower();
    }
    // Administradores: documento config/admins com o campo emails (lista, em minúsculas)
    function isAdmin() {
      return logado()
        && exists(/databases/$(database)/documents/config/admins)
        && meuEmail() in get(/databases/$(database)/documents/config/admins).data.emails;
    }
    // Pode responder se o questionário está aberto e, quando restrito, o e-mail está na lista de convidados
    function podeResponder(qid) {
      let q = get(/databases/$(database)/documents/questionarios/$(qid)).data;
      return q.ativo == true
        && (q.get('somenteConvidados', false) == false
            || meuEmail() in get(/databases/$(database)/documents/convites/$(qid)).data.get('lista', []));
    }

    match /config/admins {
      allow read: if logado();
      allow write: if isAdmin();
    }

    match /questionarios/{qid} {
      allow read: if logado();
      allow write: if isAdmin();
    }

    // Lista de e-mails convidados e texto do convite: só administradores
    match /convites/{qid} {
      allow read, write: if isAdmin();
    }

    // Uma resposta por pessoa e questionário: id = <qid>_<uid>
    match /respostas/{rid} {
      allow read: if isAdmin()
        || (logado() && (resource == null || resource.data.uid == request.auth.uid));
      allow delete: if isAdmin();
      allow create, update: if logado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == meuEmail()
        && rid == request.resource.data.qid + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['qid', 'uid', 'nome', 'email', 'respostas', 'enviadoEm'])
        && podeResponder(request.resource.data.qid);
    }
  }
}
